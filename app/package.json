{
  "name": "cascade-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "scripts": {
    "help": "node help.ts",
    "start": "node server/main.ts",
    "dev": "node server/main.ts --dev",
    "browser": "node server/browser.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "reset": "node pod.ts everything",
    "pod:load": "node pod.ts load",
    "pod:new": "node pod.ts new",
    "pod:reset": "node pod.ts reset",
    "kit:export": "node kit.ts",
    "patient:add": "node patient.ts",
    "ask": "node ask.ts",
    "console": "node console.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hono/zod-validator": "0.9.1",
    "cascade-runtime": "https://github.com/jayostis/cascade-runtime-js/releases/download/build-925fadfbc1977306a2a5979d835ae07a48933365/cascade-runtime-0.0.0-commit-925fadfbc1977306a2a5979d835ae07a48933365.tgz",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.5"
  }
