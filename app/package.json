{
  "name": "cascade-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "help": "node help.mjs",
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "build": "vite build",
    "build:browser": "vite build --mode browser",
    "next": "vite build && node server/main.ts",
    "dev:next": "node server/main.ts --dev",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "reset": "node pod.mjs everything",
    "pod:load": "node pod.mjs load",
    "pod:new": "node pod.mjs new",
    "pod:reset": "node pod.mjs reset",
    "kit:export": "node kit.mjs",
    "patient:add": "node patient.mjs",
    "ask": "node ask.mjs",
    "console": "node console.mjs",
    "mcp": "node mcp.mjs",
    "model": "node model.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.73",
    "@ai-sdk/groq": "4.0.56",
    "@ai-sdk/openai-compatible": "3.0.64",
    "@ai-sdk/react": "4.0.132",
    "@anthropic-ai/sdk": "0.128.0",
    "@assistant-ui/react": "0.15.25",
    "@assistant-ui/react-ai-sdk": "1.4.16",
    "@hono/node-server": "2.1.3",
    "@hono/zod-validator": "0.9.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.129",
    "cascade-runtime": "https://github.com/jayostis/cascade-runtime-js/releases/download/build-32e5b8c17abe3070488c12b79367232cfa182eed/cascade-runtime-0.0.0-commit-32e5b8c17abe3070488c12b79367232cfa182eed.tgz",
    "hono": "4.13.13",
    "htm": "3.1.1",
    "openai": "7.23.0",
    "preact": "11.0.0",
    "preact-render-to-string": "6.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  }
}
