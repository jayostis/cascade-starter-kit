{
  "name": "cascade-starter-kit",
  "private": true,
  "type": "module",
  "description": "The app a person starts from on cascade-runtime: the template, try/ in a browser, and create-cascade-app.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "app",
    "try",
    "create"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.scripts.json && tsc -p app/tsconfig.json && tsc -p app/tsconfig.node.json && node scripts/with-add-ons.mjs && tsc -p build/app/tsconfig.json && tsc -p build/app/tsconfig.node.json",
    "build:create": "tsc -b && node create/pack.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "tsc -b && node scripts/with-add-ons.mjs && node scripts/test.mjs",
    "build:try": "tsc -b && node dist/try/build/cli.js build-pages",
    "serve:pages": "tsc -b && node dist/try/build/cli.js serve-pages",
    "test:browser": "tsc -b && node scripts/with-add-ons.mjs && node --test dist/test-browser/try.test.js dist/test-browser/starter.test.js",
    "test:launcher": "tsc -b && node --test dist/test-browser/launcher.test.js",
    "test:live": "tsc -b && node --test dist/test-browser/live.test.js"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.73",
    "@ai-sdk/groq": "4.0.56",
    "@ai-sdk/openai-compatible": "3.0.64",
    "@ai-sdk/provider": "4.0.23",
    "@ai-sdk/react": "4.0.132",
    "@assistant-ui/react": "0.15.25",
    "@assistant-ui/react-ai-sdk": "1.4.16",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@the-cascade-protocol/sandbox": "github:jayostis/cascade-sandbox#a33529e58830cb8b9c04f9c19c9e666f45634e3c",
    "@types/node": "22.20.5",
    "ai": "7.0.129",
    "cascade-reference-tables": "github:jayostis/cascade-reference-tables#abcb8bd9a99f3f2d9b33351b97416fc0b81f7bab",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "oxigraph": "0.5.11",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.3"
  }
}
