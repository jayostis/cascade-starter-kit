{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "sourceMap": false,
    "strict": false,
    "noUncheckedIndexedAccess": false,
    "erasableSyntaxOnly": true
  },
  "include": [
    "check/*.ts",
    "create/*.mjs",
    "scripts/pin.mjs",
    "scripts/pin-lib.mjs"
  ]
}
